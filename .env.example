# ── CONFIGURACIÓN DEL SERVIDOR WEB ──
# Puerto en el que deseas exponer la aplicación (Ej: 8080, 8000, 3000)
APP_PORT=8080

# ── CONFIGURACIÓN DE BASE DE DATOS ──
DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=sistema_moda
